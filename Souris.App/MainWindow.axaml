<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Souris.App.MainWindow"
        Title="Souris — apprendre la souris"
        Width="1180"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2266CC" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#BFD8FF" />
      <Setter Property="BorderBrush" Value="#2266CC" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A8CCFF" />
      <Setter Property="BorderBrush" Value="#2266CC" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
    <Style Selector="Button.contextMenuItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="#202020" />
    </Style>
    <Style Selector="Button.contextMenuItem:pointerover">
      <Setter Property="Background" Value="#DCEBFA" />
      <Setter Property="BorderBrush" Value="#DCEBFA" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
    <Style Selector="Button.contextMenuItem:pressed">
      <Setter Property="Background" Value="#C7DEF5" />
      <Setter Property="BorderBrush" Value="#C7DEF5" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
  </Window.Styles>
  <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
  <Grid Width="1180" Height="780" ColumnDefinitions="260,*">
    <Border Grid.Column="0" Background="#E9EFFA" Padding="18">
      <Grid RowDefinitions="Auto,*">
        <Border Margin="0,0,0,18" Background="White"
                CornerRadius="14" Padding="16">
          <TextBlock x:Name="ProgressLabel" FontSize="17" FontWeight="SemiBold"
                     Foreground="#17345C" Text="0 / 6 exercices réussis"
                     TextAlignment="Center" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SectionNavigation" Spacing="8" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="26,22,26,22">
      <StackPanel Spacing="7" Margin="2,0,2,18">
        <TextBlock x:Name="StageLabel" FontSize="15" FontWeight="SemiBold"
                   Foreground="#2266CC" />
        <TextBlock x:Name="SectionHeading" FontSize="30" FontWeight="Bold"
                   Foreground="#17345C" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="1" Background="White" CornerRadius="18" Padding="28">
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="StageContent" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,0">
        <Button x:Name="BackButton" Grid.Column="0" Classes="primary" Content="Retour"
                FontSize="18" MinHeight="54" MinWidth="132" Padding="20,10"
                Click="OnBackClicked" />
        <Button x:Name="NextButton" Grid.Column="2" Classes="primary" Content="Suivant"
                FontSize="18" FontWeight="SemiBold" MinHeight="54" MinWidth="170"
                Padding="20,10"
                Click="OnNextClicked" />
      </Grid>
    </Grid>
  </Grid>
  </Viewbox>
</Window>
