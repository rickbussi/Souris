<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Souris</AssemblyName>
    <RootNamespace>Souris.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/souris.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content/Tutoriel.md" />
    <AvaloniaResource Include="Assets/cappuccino-heart.png" />
    <AvaloniaResource Include="Assets/suv-gris.png" />
    <AvaloniaResource Include="Assets/ballon-plage.png" />
    <AvaloniaResource Include="Assets/cavalier-echecs.png" />
    <None Update="Assets/souris-icon.png" CopyToPublishDirectory="PreserveNewest" TargetPath="souris-icon.png" />
    <None Include="../publish-linux.sh" Link="publish-linux.sh" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <ExcludeAssets Condition="'$(Configuration)' != 'Debug'">all</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
